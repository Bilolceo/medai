# Host-side config: for running the app or tools (e.g. `alembic`, `pytest`)
# directly on your machine against the Dockerized Postgres/Redis, which
# publish to these host ports (see docker-compose.yml). Postgres is on 5433,
# not 5432, to avoid colliding with any native PostgreSQL install already
# using 5432 on this machine.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/dental_ig_assistant
REDIS_URL=redis://localhost:6379/0
# OpenAI writes the replies and makes every embedding, so this key is
# required — Settings refuses to boot without it.
OPENAI_API_KEY=sk-your-key-here
# Which OpenAI model answers. Leave unset for the pinned default
# (gpt-5-mini). Name a concrete version, never an alias: an alias can move
# the model under a running deployment.
# OPENAI_MODEL=

# An escape hatch, for the afternoon OpenAI is unreachable: it moves the
# replies alone and leaves the embeddings on OpenAI. Swapping the model that
# writes a reply costs nothing; swapping the one that makes embeddings
# invalidates every vector in knowledge_base and means re-embedding the
# clinic's whole FAQ, which is why these are separable.
# LLM_PROVIDER=qwen
# HF_TOKEN=
# QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
WEBHOOK_VERIFY_TOKEN=change-me-verify-token
META_APP_SECRET=change-me-app-secret
# Fernet key encrypting channel.credentials at rest (app.core.encryption).
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key
# Signs the operator dashboard's session cookie (app.core.session).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-generate-a-real-session-secret
# true in production (which must be behind HTTPS): the login cookie then
# carries the Secure flag and a browser will not send it over plain http.
# Left false for local dev, where http://localhost would otherwise make the
# browser silently refuse to store it and login would appear to do nothing.
SESSION_COOKIE_SECURE=false

# Instagram access token for the channel this deployment serves. Read only by
# first-run provisioning (see below); the running pipeline reads the token
# from the encrypted channel row, never from configuration.
ACCESS_TOKEN=
# Set both to have web startup create the tenant + Instagram channel this
# deployment serves, for hosts where the database is only reachable from
# inside the cluster and scripts/bootstrap_tenant.py cannot be run. Leave
# unset to skip provisioning entirely; remove them again once the rows exist.
# PROVISION_IG_ACCOUNT_ID is the id Meta sends as entry.id in the webhook
# (the 17841... Instagram Business Account id), NOT the id graph.instagram.com
# /me returns -- they are different namespaces.
PROVISION_TENANT_NAME=
PROVISION_IG_ACCOUNT_ID=

# This deployment's own public https:// origin, e.g.
# https://clinic-bot.up.railway.app -- no trailing path. Used only to tell
# Telegram where to deliver updates; the container cannot work it out for
# itself, since the hostname it has inside the cluster is not the one the
# outside world reaches it by.
PUBLIC_BASE_URL=

# The clinic's Telegram bot token from @BotFather. Read only by first-run
# provisioning, like ACCESS_TOKEN above: it is verified with getMe, stored
# encrypted on the channel row, and the webhook is registered for you. The
# running pipeline reads the token from that row, never from here.
PROVISION_TELEGRAM_BOT_TOKEN=

# The first dashboard login. There is no sign-up page, so without these a
# fresh deployment cannot be logged into at all. Created once and then left
# alone -- changing the password here later does NOT change the account's
# password, so that a redeploy cannot undo a password changed in the
# dashboard. Minimum 10 characters; a shorter one is refused rather than
# accepted.
PROVISION_OPERATOR_USERNAME=
PROVISION_OPERATOR_PASSWORD=
PROVISION_OPERATOR_NAME=Administrator
# "operator" (view + book/cancel) or "doctor" (view-only). The first account
# should be an operator: it is the only one that exists until it makes others.
PROVISION_OPERATOR_ROLE=operator

# Language to reply in when the patient's own is unclear (short or
# transliterated messages). Written in English, since it goes into an English
# system prompt: "Uzbek", "Russian", "English".
DEFAULT_REPLY_LANGUAGE=Uzbek, in the Latin alphabet

# Seconds to wait for the patient to keep typing before the bot answers.
# The wait is what lets a question split across bubbles ("Salom" / "narxi
# qancha?") get a single answer instead of one per bubble -- but the patient
# spends it watching a silent chat, so keep it short. 0 turns batching off
# and answers every bubble separately.
DEBOUNCE_WINDOW_SECONDS=5

# The clinic's own reception numbers, read back verbatim to a patient whose
# price question the knowledge base cannot answer. Free-form -- write it the
# way you want it said, e.g. "+998 90 123 45 67 or +998 71 200 00 00". Leave
# it empty and the assistant only offers a callback instead; it will never
# invent a number to read out.
CLINIC_PHONE_NUMBERS=

# The clinic's street address, stated to a patient who asks where it is.
# Free-form, landmark included. Leave empty and the assistant will not give
# out an address at all.
CLINIC_ADDRESS=

# Path to a FAQ JSON file to load into the knowledge base on web startup.
# An instruction to seed, not a description of the running system: set it for
# the deploy that loads the file, then unset it again. Leave empty to skip.
# The same file can be loaded from a shell with scripts/ingest_faqs.py.
SEED_FAQS_FROM=

# --- the clinic's own spreadsheet ------------------------------------------
# Clinic owners open the sheet they already keep, not a dashboard, so leads
# are mirrored there too: ism familiya | telefon | manba | qisqacha.
# A mirror, never a source — nothing is read back, and losing the sheet
# loses nothing the database does not still hold. Unset, the whole thing is
# off and nothing is attempted.
#
# The service-account JSON, whole. It contains newlines inside private_key,
# so base64 is accepted too, for hosts whose variables cannot carry them.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# The id from the sheet's URL: docs.google.com/spreadsheets/d/<id>/edit
# The sheet must be shared with the service account's own address, as Editor.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# The tabs are named by date and created as leads arrive, one per day,
# so there is nothing to configure for them.

# Set both when this deployment answers one doctor's own Instagram instead of
# the clinic's. The assistant then speaks as the person running that doctor's
# inbox (never as the doctor). Leave either unset for the clinic front desk.
DOCTOR_NAME=
DOCTOR_SPECIALTY=
# What the sign-in page calls the product (it is shown before anybody is
# logged in). The dashboard itself is headed with the doctor's own name from
# the account's "brand_title" setting, or the account's name. The doctor's
# week (days, hours, minutes a patient) is in the account's settings too --
# see docs/NEW_DOCTOR.md.
# PRODUCT_NAME=medai

# Who may set rules, and with what keyword. For a doctor's own account the
# owner types the rule into a chat with one of OWNER_RULE_RECIPIENTS (they
# cannot message their own inbox); anywhere else it is ignored.
ADMIN_INSTAGRAM_USERNAMES=
ADMIN_COMMAND_KEYWORD=
OWNER_RULE_RECIPIENTS=

# The doctor's own Telegram bot: new appointments, the day's list, and
# "bugun kela olmayman" to cancel a day and tell the patients. Token from
# @BotFather; usernames are the Telegram handles allowed to use it.
DOCTOR_TELEGRAM_BOT_TOKEN=
DOCTOR_TELEGRAM_USERNAMES=

# Dr. Temur's training and experience, told to a patient only when asked.
# One fact per " | ".
DOCTOR_BACKGROUND=
# true: the assistant books appointments itself (name -> phone -> complaint
# -> a free 20-minute slot). false: every patient is sent to the telephone.
BOOKING_ENABLED=false
